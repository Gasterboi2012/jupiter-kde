// Jupiter fastfetch config (system-wide: /etc/xdg/fastfetch/config.jsonc).
// Users can copy this to ~/.config/fastfetch/config.jsonc to customise it.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // PLACEHOLDER text logo. Point "source" at a new file later (text or image).
        "type": "file",
        "source": "/usr/share/jupiter/branding/ascii.txt",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "size": {
            "binaryPrefix": "si"
        },
        "color": {
            "keys": "blue",
            "title": "bright_blue"
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "────────────────────────────"
        },
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}
